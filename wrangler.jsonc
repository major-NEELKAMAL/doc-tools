{
  // Cloudflare Workers static-assets deploy (image-piture.com).
  "name": "doc-tools",
  "compatibility_date": "2026-11-01",
  // Keep the doc-tools.<account>.workers.dev URL and per-version preview URLs
  // (both are wrangler defaults; set explicitly to silence build warnings).
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/doc-watermark/browser",
    "not_found_handling": "single-page-application"
  }
}
